    STORE <-->|"persist middleware\n(serializa/lê)"| LS
    LS -.->|"merge() na reidratação"| PARSE
    PARSE -->|"shape inválido → []"| STORE

    FAVPAGE -->|"favoriteIds"| STORE
    FAVPAGE -->|"page=1, pageSize=50"| USECHANNELS
    FAVPAGE -->|"filtra items por favoriteIds.includes(id)\n(cruza client state + server state, sem endpoint novo)"| CARD
